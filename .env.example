# No API keys, accounts or Google billing required.
HOST=127.0.0.1
PORT=63119
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
UPSTREAM_USER_AGENT=HangoutRoutePlanner/1.1 (private hackathon prototype)
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Leave empty for the built browser app. Set your computer's LAN API URL for phones.
EXPO_PUBLIC_API_BASE_URL=

# Use dated Tbilisi OSM venues immediately; false enables live-first search.
PREFER_LOCAL_PLACES=true

# For votes on other devices: HOST=0.0.0.0 enables LAN access.
# Override the detected LAN link when using a hosted app or a different interface.
PUBLIC_APP_URL=
